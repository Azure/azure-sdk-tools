 internal sealed class PackagePollingClient(IPackageStatusClient sdk)
 {
     public async Task WaitForCompletionAsync(CancellationToken ct)
     {
         using var deadline = CancellationTokenSource.CreateLinkedTokenSource(ct);
-        deadline.CancelAfter(TimeSpan.FromMinutes(5));
 
         while (true)
         {
             deadline.Token.ThrowIfCancellationRequested();
             var status = await sdk.GetStatusAsync(deadline.Token);
             if (status == PackageStatus.Completed)
             {
                 return;
             }
 
             await Task.Delay(TimeSpan.FromSeconds(1), deadline.Token);
         }
     }
 }
