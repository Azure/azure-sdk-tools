# Configuration reference only; do not add credentials or SAS URLs.
# Local demonstration: npm run poc:start (sets explicit loopback POC options).

# Hosted settings: fill these once the Azure resources are provided.
HOST=0.0.0.0
VALLY_STORAGE_PROVIDER=azure
VALLY_AZURE_CONTAINER_URL=
VALLY_AZURE_QUEUE_URL=
VALLY_INGEST_TENANT_ID=
VALLY_INGEST_AUDIENCE=
VALLY_INGEST_CLIENT_IDS=

# Instance-local query cache. Keep exactly one writer/instance.
# Persistent history/receipts are in Blob; this cache needs explicit replay if lost.
VALLY_DB=/tmp/vally-dashboard/eval.db
VALLY_STAGING_ROOT=/tmp/vally-dashboard/staging

# Optional custom hostname; WEBSITE_HOSTNAME is automatically included.
VALLY_ALLOWED_HOSTS=
# Optional user-assigned managed identity client ID for DefaultAzureCredential.
AZURE_CLIENT_ID=

# Network policy is configured in Azure, not by these environment variables:
# publicNetworkAccess=Disabled; approved private endpoint + private DNS/VPN route;
# viewer Easy Auth disabled; publishing and deployment agents have private routes.
# NEVER set VALLY_LOCAL_POC=true on a hosted service.