          "changes": [
            {
              "kind": "modified",
              "summary": "Replace OpenAPI-only long-running-operation extensions with Azure.Core @useFinalStateVia(\"location\"), preserving all six REST contracts while making three operations consistently recognizable as LROs to SDK generators.",
              "operationIds": [
                "ScenarioConfigurations_Execute",
                "ScenarioConfigurations_Validate",
                "ScenarioConfigurations_Cancel",
                "ScenarioConfigurations_FixResourcePermissions",
                "ScenarioRuns_Cancel",
                "Workspaces_RefreshRecommendations"
              ],
              "apiVersions": [
                "2026-05-01-preview",
                "2024-11-01-preview"
              ],
              "aspects": [
                {
                  "field": "TypeSpec LRO metadata",
                  "before": "The operations use raw OpenAPI LRO extensions and operation-level polling metadata while already returning 202 with Location and Retry-After headers.",
                  "after": "The shared TypeSpec helpers use @Azure.Core.useFinalStateVia(\"location\") to represent the same 202 Location-polled REST behavior."
                }
              ],
              "effect": "All six POST operations retain their existing 202 responses, Location and Retry-After headers, and Location-based final-state behavior; the change represents that existing LRO contract directly in TypeSpec.",
              "typeSpecCause": "Replace OpenAPI-only LRO extensions with @Azure.Core.useFinalStateVia(\"location\") and remove redundant explicit polling metadata.",
