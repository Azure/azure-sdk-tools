      "findings": [
        {
          "id": "pr-43308-lro-recognition",
          "title": "Three generated SDK methods change from basic to long-running",
          "severity": "high",
          "confidence": "high",
          "summary": "The wire contract is unchanged, but ScenarioConfigurations.execute, legacy ScenarioConfigurations.cancel, and ScenarioRuns.cancel now expose poller/LRO return types and asynchronous completion semantics.",
          "evidence": [
            "Before the change, generated clients treat the three methods as ordinary operations rather than long-running operations.",
            "After the change, generated clients expose Location-polled LRO behavior with typed final responses.",
            "Base/head OpenAPI method, path, parameters, responses, x-ms-long-running-operation, and final-state-via values are identical."
          ],
          "sourceReferences": [
            {
              "path": "specification/chaos/resource-manager/Microsoft.Chaos/Chaos/lro-helpers.tsp",
