import "@typespec/json-schema";

using TypeSpec.JsonSchema;

namespace AzureSdkMetrics;

@minValue(0)
scalar Count extends integer;

@minValue(0)
@maxValue(1)
scalar Ratio extends numeric;

enum Category {
  /** Azure.ResourceManager and Azure.ResourceManager.* libraries. */
  management: "management",

  /** All other shipping Azure.* libraries, including shared runtime libraries. */
  dataPlane: "data-plane",

  /** Azure.Provisioning and Azure.Provisioning.* libraries. */
  provisioning: "provisioning",
}

enum Provenance {
  /** No generated header, Generated directory, or generated-file suffix. */
  custom: "custom",

  /** Generated header, Generated directory, or .g.cs/.generated.cs/.designer.cs suffix. */
  generated: "generated",
}

enum Evidence {
  /** An auto-generated marker was found in the leading comment preamble. */
  generatedHeader: "auto-generated-header",

  /** Generated directory or generated-file suffix, without a generated header. */
  unmarkedGeneratedLocation: "generated-location-without-header",

  /** No generated header or generated-path convention was found. */
  noGeneratedSignal: "no-generated-signal",
}

/**
 * Counts for a library or group of libraries. Source under
 * sdk/core/<package>/src/Shared is excluded from other consuming libraries,
 * but retained in its owning core library. Other linked source counts once per
 * consuming library. Group ratios divide summed counts, not averaged ratios.
 */
model Metrics {
  /** One for an individual library. */
  libraryCount: Count;

  customFiles: Count;
  generatedFiles: Count;

  /** customFiles + generatedFiles. */
  totalFiles: Count;

  /** Physical custom-source lines, including comments and blank lines. */
  customLines: Count;

  /** Physical generated-source lines, including comments and blank lines. */
  generatedLines: Count;

  /** customLines + generatedLines. */
  totalLines: Count;

  /** customLines / totalLines; null when totalLines is zero. */
  customRatio: Ratio | null;
}

model CategoryMetrics {
  category: Category;
  metrics: Metrics;
}

model ServiceMetrics {
  /** Directory immediately below sdk, not an inferred ARM resource provider. */
  @minLength(1)
  service: string;

  metrics: Metrics;

  @minItems(3)
  @maxItems(3)
  categories: CategoryMetrics[];
}

/**
 * Optional audit data for counted files only; contains paths and counts, not
 * source contents. Excluded linked core Shared helpers have no evidence record.
 */
model FileMetrics {
  @pattern("^sdk/.*\\.cs$")
  path: string;

  /** Physical lines; an empty file has zero lines. */
  lines: Count;

  provenance: Provenance;
  evidence: Evidence;
}

/** A shipping Azure.* library and its compiled, Git-tracked C# source. */
model LibraryMetrics {
  /** Stable package ID used to match a library across observations. */
  @pattern("^Azure\\.")
  library: string;

  @minLength(1)
  service: string;

  category: Category;

  @pattern("^sdk/")
  projectPath: string;

  /** Evaluated target frameworks; source files are unioned across them. */
  @uniqueItems
  targetFrameworks: string[];

  metrics: Metrics;

  /** Counted files only, present when the collector is run with -IncludeFiles. */
  files?: FileMetrics[];
}

model Repository {
  name: "Azure/azure-sdk-for-net";

  /** HEAD commit SHA. A dirty checkout may contain source differing from it. */
  @pattern("^[0-9a-f]{40,64}$")
  commit: string;

  /** True when tracked files differ from HEAD. Untracked files do not set this flag. */
  isDirty: boolean;
}

/** A discovered project excluded by its evaluated package or shipping metadata. */
model ExcludedLibrary {
  @pattern("^sdk/")
  projectPath: string;

  reason: "not-a-shipping-Azure-client-library";
}

@jsonSchema
@id("https://raw.githubusercontent.com/Azure/azure-sdk-tools/main/tools/custom-code-metrics/schemas/CustomCodeMetrics.schema.json")
@summary("Azure SDK for .NET custom code metrics snapshot")
@extension(
  "$comment",
  "Generated from tools/custom-code-metrics/main.tsp in Azure/azure-sdk-tools. Run npm run generate in tools/custom-code-metrics; do not edit this file directly."
)
model CustomCodeMetrics {
  /** Version 3 excludes linked core Shared helpers from other consuming libraries. */
  schemaVersion: "3.0";

  /** Immutable observation identity formed from its UTC timestamp and commit. */
  @pattern("^[0-9]{8}T[0-9]{13}Z-[0-9a-f]{40,64}$")
  snapshotId: string;

  /** Observation time, emitted in UTC by the collector. */
  // JSON Schema validators may treat date-time format as an annotation.
  @extension(
    "pattern",
    "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
  )
  collectedAt: utcDateTime;

  repository: Repository;

  /** Library-weighted repository totals, not unique repository-file counts. */
  summary: Metrics;

  /** All three library categories, including categories with no libraries. */
  @minItems(3)
  @maxItems(3)
  categories: CategoryMetrics[];

  /** Totals and category subtotals for each included service directory. */
  services: ServiceMetrics[];

  /** Included shipping Azure.* libraries. Tests, samples, and tooling are excluded. */
  @minItems(1)
  libraries: LibraryMetrics[];

  /** Projects discovered but not included in the measured portfolio. */
  excludedLibraries: ExcludedLibrary[];
}

/** Counts and membership required to recompute filtered, fixed-cohort trends. */
model HistoryLibrary {
  ...PickProperties<
    LibraryMetrics,
    "library" | "service" | "category" | "metrics"
  >;
}

/** A compact observation, without project details or per-file audit evidence. */
model HistoryObservation {
  ...PickProperties<
    CustomCodeMetrics,
    "schemaVersion" | "snapshotId" | "collectedAt" | "repository"
  >;

  @minItems(1)
  libraries: HistoryLibrary[];
}

/** Immutable, content-addressed history for a single UTC calendar month. */
@jsonSchema
@id("https://raw.githubusercontent.com/Azure/azure-sdk-tools/main/tools/custom-code-metrics/schemas/HistoryMonth.schema.json")
@extension(
  "$comment",
  "Generated from tools/custom-code-metrics/main.tsp in Azure/azure-sdk-tools. Run npm run generate in tools/custom-code-metrics; do not edit this file directly."
)
model HistoryMonth {
  schemaVersion: "1.0";

  @pattern("^[0-9]{4}-(0[1-9]|1[0-2])$")
  month: string;

  @minItems(1)
  observations: HistoryObservation[];
}

model HistoryReference {
  @pattern("^[0-9]{4}-(0[1-9]|1[0-2])$")
  month: string;

  @pattern("^history/[0-9a-f]{64}/[0-9]{4}-(0[1-9]|1[0-2])\\.json$")
  path: string;
}

/** Revalidated discovery document; publish only after every referenced blob exists. */
@jsonSchema
@id("https://raw.githubusercontent.com/Azure/azure-sdk-tools/main/tools/custom-code-metrics/schemas/ReportIndex.schema.json")
@extension(
  "$comment",
  "Generated from tools/custom-code-metrics/main.tsp in Azure/azure-sdk-tools. Run npm run generate in tools/custom-code-metrics; do not edit this file directly."
)
model ReportIndex {
  schemaVersion: "1.0";

  /** Latest complete snapshot, relative to this index. */
  @pattern("^snapshots/[0-9]{8}T[0-9]{13}Z-[0-9a-f]{40,64}\\.json$")
  latest: string;

  /** Monthly history is fetched on demand, not downloaded in full at startup. */
  @minItems(1)
  history: HistoryReference[];
}
