{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TypeSpec Assessment Judgment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "semanticIntents",
    "restDecisions",
    "downstreamDecisions",
    "complianceDecisions",
    "overallConfidence",
    "blockers"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "semanticIntents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewUnitId", "title", "summary"],
        "properties": {
          "reviewUnitId": { "type": "string", "pattern": "^semantic-" },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "restDecisions": { "$ref": "#/$defs/decisions" },
    "downstreamDecisions": { "$ref": "#/$defs/decisions" },
    "complianceDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewUnitId",
          "applicableGuidance",
          "sourceChangeIds",
          "hunkIds",
          "declarationIds",
          "decision",
          "actual",
          "rationale"
        ],
        "properties": {
          "reviewUnitId": { "type": "string", "pattern": "^semantic-" },
          "applicableGuidance": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["canonicalDocumentUrl", "guidanceSection"],
              "properties": {
                "canonicalDocumentUrl": { "type": "string", "format": "uri" },
                "guidanceSection": { "type": "string", "minLength": 1 }
              }
            }
          },
          "sourceChangeIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^source-" }
          },
          "hunkIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^hunk-" }
          },
          "declarationIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^declaration-" }
          },
          "decision": {
            "enum": ["applicable-pass", "applicable-fail", "no-applicable-guidance", "not-assessed"]
          },
          "title": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["high", "medium", "low"] },
          "expected": { "type": "string", "minLength": 1 },
          "actual": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "decision": {
                  "enum": ["applicable-pass", "applicable-fail"]
                }
              }
            },
            "then": {
              "required": ["expected"],
              "properties": {
                "applicableGuidance": { "minItems": 1 },
                "sourceChangeIds": { "minItems": 1 },
                "hunkIds": { "minItems": 1 },
                "declarationIds": { "minItems": 1 }
              }
            }
          },
          {
            "if": {
              "properties": {
                "decision": { "const": "applicable-fail" }
              }
            },
            "then": {
              "required": ["title", "severity"]
            }
          }
        ]
      }
    },
    "sdkNaming": { "$ref": "#/$defs/sdkNamingDimension" },
    "overallConfidence": { "enum": ["high", "medium", "low"] },
    "blockers": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "sdkNamingCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "serviceType", "status", "rationale"],
      "properties": {
        "language": { "type": "string", "minLength": 1 },
        "serviceType": { "enum": ["arm", "data-plane", "unknown"] },
        "profile": { "type": "string", "minLength": 1 },
        "status": { "enum": ["reviewed", "not-covered", "not-assessed"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "sdkNamingFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "declaration",
        "currentSdkName",
        "languageScope",
        "decision",
        "rule",
        "rationale",
        "compatibilityEvidence",
        "verification"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^sdk-naming-[0-9a-f]{16}$" },
        "reviewUnitId": { "type": "string", "pattern": "^semantic-" },
        "declaration": { "type": "string", "minLength": 1 },
        "currentSdkName": { "type": "string", "minLength": 1 },
        "recommendedSdkName": { "type": "string", "minLength": 1 },
        "languageScope": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["recommend", "blocked"] },
        "rule": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "compatibilityEvidence": { "type": "string", "minLength": 1 },
        "verification": { "enum": ["proposed", "supplied-generated", "applied"] },
        "sourceLocation": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "recommend" } } },
          "then": { "required": ["recommendedSdkName"] }
        }
      ]
    },
    "sdkNamingDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "coverage", "findings", "blockers"],
      "properties": {
        "status": { "enum": ["passed", "failed", "not-assessed"] },
        "summary": { "type": "string", "minLength": 1 },
        "coverage": {
          "type": "array",
          "items": { "$ref": "#/$defs/sdkNamingCoverage" }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/sdkNamingFinding" }
        },
        "blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateId", "decision", "rationale"],
        "properties": {
          "candidateId": { "type": "string" },
          "decision": { "enum": ["approve", "reject"] },
          "severity": { "enum": ["high", "medium", "low"] },
          "rationale": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "decision": { "const": "approve" } } },
            "then": { "required": ["severity"] }
          }
        ]
      }
    }
  }
}
