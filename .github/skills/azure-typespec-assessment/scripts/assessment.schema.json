{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TypeSpec Assessment",
  "type": "object",
  "required": [
    "schemaVersion",
    "comparison",
    "confidence",
    "safety",
    "dimensions",
    "blockers"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "comparison": {
      "type": "object",
      "required": ["baseRef", "baseCommit", "headCommit", "workingTree"],
      "properties": {
        "baseRef": { "type": "string" },
        "baseCommit": { "type": "string" },
        "headCommit": { "type": "string" },
        "workingTree": { "type": "object" }
      }
    },
    "confidence": { "enum": ["high", "medium", "low"] },
    "safety": {
      "type": "object",
      "required": ["scope", "status"],
      "properties": {
        "scope": { "const": "rest-and-downstream-only" },
        "status": { "enum": ["passed", "failed", "not-assessed"] }
      }
    },
    "dimensions": {
      "type": "object",
      "required": [
        "semantic",
        "rest",
        "downstream",
        "compliance",
        "documentQuality"
      ]
    },
    "blockers": { "type": "array" }
  }
}
