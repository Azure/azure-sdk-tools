{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/Azure/azure-sdk-tools/main/tools/custom-code-metrics/schemas/CustomCodeMetrics.schema.json",
    "type": "object",
    "properties": {
        "schemaVersion": {
            "type": "string",
            "const": "3.0",
            "description": "Version 3 excludes linked core Shared helpers from other consuming libraries."
        },
        "snapshotId": {
            "type": "string",
            "pattern": "^[0-9]{8}T[0-9]{13}Z-[0-9a-f]{40,64}$",
            "description": "Immutable observation identity formed from its UTC timestamp and commit."
        },
        "collectedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Observation time, emitted in UTC by the collector.",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
        },
        "repository": {
            "$ref": "#/$defs/Repository"
        },
        "summary": {
            "$ref": "#/$defs/Metrics",
            "description": "Library-weighted repository totals, not unique repository-file counts."
        },
        "categories": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/CategoryMetrics"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "All three library categories, including categories with no libraries."
        },
        "services": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/ServiceMetrics"
            },
            "description": "Totals and category subtotals for each included service directory."
        },
        "libraries": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/LibraryMetrics"
            },
            "minItems": 1,
            "description": "Included shipping Azure.* libraries. Tests, samples, and tooling are excluded."
        },
        "excludedLibraries": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/ExcludedLibrary"
            },
            "description": "Projects discovered but not included in the measured portfolio."
        }
    },
    "required": [
        "schemaVersion",
        "snapshotId",
        "collectedAt",
        "repository",
        "summary",
        "categories",
        "services",
        "libraries",
        "excludedLibraries"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "title": "Azure SDK for .NET custom code metrics snapshot",
    "$comment": "Generated from tools/custom-code-metrics/main.tsp in Azure/azure-sdk-tools. Run npm run generate in tools/custom-code-metrics; do not edit this file directly.",
    "$defs": {
        "Repository": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "const": "Azure/azure-sdk-for-net"
                },
                "commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40,64}$",
                    "description": "HEAD commit SHA. A dirty checkout may contain source differing from it."
                },
                "isDirty": {
                    "type": "boolean",
                    "description": "True when tracked files differ from HEAD. Untracked files do not set this flag."
                }
            },
            "required": [
                "name",
                "commit",
                "isDirty"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "Metrics": {
            "type": "object",
            "properties": {
                "libraryCount": {
                    "$ref": "#/$defs/Count",
                    "description": "One for an individual library."
                },
                "customFiles": {
                    "$ref": "#/$defs/Count"
                },
                "generatedFiles": {
                    "$ref": "#/$defs/Count"
                },
                "totalFiles": {
                    "$ref": "#/$defs/Count",
                    "description": "customFiles + generatedFiles."
                },
                "customLines": {
                    "$ref": "#/$defs/Count",
                    "description": "Physical custom-source lines, including comments and blank lines."
                },
                "generatedLines": {
                    "$ref": "#/$defs/Count",
                    "description": "Physical generated-source lines, including comments and blank lines."
                },
                "totalLines": {
                    "$ref": "#/$defs/Count",
                    "description": "customLines + generatedLines."
                },
                "customRatio": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Ratio"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "customLines / totalLines; null when totalLines is zero."
                }
            },
            "required": [
                "libraryCount",
                "customFiles",
                "generatedFiles",
                "totalFiles",
                "customLines",
                "generatedLines",
                "totalLines",
                "customRatio"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Counts for a library or group of libraries. Source under\nsdk/core/<package>/src/Shared is excluded from other consuming libraries,\nbut retained in its owning core library. Other linked source counts once per\nconsuming library. Group ratios divide summed counts, not averaged ratios."
        },
        "CategoryMetrics": {
            "type": "object",
            "properties": {
                "category": {
                    "$ref": "#/$defs/Category"
                },
                "metrics": {
                    "$ref": "#/$defs/Metrics"
                }
            },
            "required": [
                "category",
                "metrics"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "ServiceMetrics": {
            "type": "object",
            "properties": {
                "service": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Directory immediately below sdk, not an inferred ARM resource provider."
                },
                "metrics": {
                    "$ref": "#/$defs/Metrics"
                },
                "categories": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/CategoryMetrics"
                    },
                    "minItems": 3,
                    "maxItems": 3
                }
            },
            "required": [
                "service",
                "metrics",
                "categories"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "LibraryMetrics": {
            "type": "object",
            "properties": {
                "library": {
                    "type": "string",
                    "pattern": "^Azure\\.",
                    "description": "Stable package ID used to match a library across observations."
                },
                "service": {
                    "type": "string",
                    "minLength": 1
                },
                "category": {
                    "$ref": "#/$defs/Category"
                },
                "projectPath": {
                    "type": "string",
                    "pattern": "^sdk/"
                },
                "targetFrameworks": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "uniqueItems": true,
                    "description": "Evaluated target frameworks; source files are unioned across them."
                },
                "metrics": {
                    "$ref": "#/$defs/Metrics"
                },
                "files": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/FileMetrics"
                    },
                    "description": "Counted files only, present when the collector is run with -IncludeFiles."
                }
            },
            "required": [
                "library",
                "service",
                "category",
                "projectPath",
                "targetFrameworks",
                "metrics"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "A shipping Azure.* library and its compiled, Git-tracked C# source."
        },
        "ExcludedLibrary": {
            "type": "object",
            "properties": {
                "projectPath": {
                    "type": "string",
                    "pattern": "^sdk/"
                },
                "reason": {
                    "type": "string",
                    "const": "not-a-shipping-Azure-client-library"
                }
            },
            "required": [
                "projectPath",
                "reason"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "A discovered project excluded by its evaluated package or shipping metadata."
        },
        "Count": {
            "type": "integer",
            "minimum": 0
        },
        "Ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
        },
        "Category": {
            "type": "string",
            "enum": [
                "management",
                "data-plane",
                "provisioning"
            ]
        },
        "FileMetrics": {
            "type": "object",
            "properties": {
                "path": {
                    "type": "string",
                    "pattern": "^sdk/.*\\.cs$"
                },
                "lines": {
                    "$ref": "#/$defs/Count",
                    "description": "Physical lines; an empty file has zero lines."
                },
                "provenance": {
                    "$ref": "#/$defs/Provenance"
                },
                "evidence": {
                    "$ref": "#/$defs/Evidence"
                }
            },
            "required": [
                "path",
                "lines",
                "provenance",
                "evidence"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Optional audit data for counted files only; contains paths and counts, not\nsource contents. Excluded linked core Shared helpers have no evidence record."
        },
        "Provenance": {
            "type": "string",
            "enum": [
                "custom",
                "generated"
            ]
        },
        "Evidence": {
            "type": "string",
            "enum": [
                "auto-generated-header",
                "generated-location-without-header",
                "no-generated-signal"
            ]
        }
    }
}