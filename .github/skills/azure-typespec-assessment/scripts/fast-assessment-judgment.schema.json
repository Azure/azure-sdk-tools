{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.github.io/azure-sdk-tools/schemas/fast-assessment-judgment.schema.json",
  "title": "Fast Azure TypeSpec impact assessment judgment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "restCandidates",
    "downstreamCandidates",
    "compliance",
    "overallConfidence",
    "blockers"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "restCandidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidateDecision" }
    },
    "downstreamCandidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidateDecision" }
    },
    "compliance": { "$ref": "#/$defs/compliance" },
    "overallConfidence": { "$ref": "#/$defs/level" },
    "blockers": { "$ref": "#/$defs/strings" }
  },
  "$defs": {
    "string": { "type": "string", "minLength": 1 },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/string" }
    },
    "level": { "enum": ["high", "medium", "low"] },
    "impact": {
      "type": "object",
      "required": [
        "title",
        "severity",
        "confidence",
        "actual",
        "expected",
        "evidence",
        "affectedOperationIds",
        "sourceChangeIds",
        "sourcePaths"
      ],
      "properties": {
        "title": { "$ref": "#/$defs/string" },
        "severity": { "$ref": "#/$defs/level" },
        "confidence": { "$ref": "#/$defs/level" },
        "actual": { "$ref": "#/$defs/string" },
        "expected": { "$ref": "#/$defs/string" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/string" }
        },
        "affectedOperationIds": { "$ref": "#/$defs/strings" },
        "sourceChangeIds": { "$ref": "#/$defs/strings" },
        "sourcePaths": { "$ref": "#/$defs/strings" }
      }
    },
    "candidateDecision": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/impact" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "decision"],
              "properties": {
                "id": { "$ref": "#/$defs/string" },
                "decision": { "const": "approve" },
                "title": true,
                "severity": true,
                "confidence": true,
                "actual": true,
                "expected": true,
                "evidence": true,
                "affectedOperationIds": true,
                "sourceChangeIds": true,
                "sourcePaths": true
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "decision", "rationale"],
          "properties": {
            "id": { "$ref": "#/$defs/string" },
            "decision": { "const": "reject" },
            "rationale": { "$ref": "#/$defs/string" }
          }
        }
      ]
    },
    "complianceFinding": {
      "allOf": [
        { "$ref": "#/$defs/impact" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "documentationUrl"],
          "properties": {
            "id": { "$ref": "#/$defs/string" },
            "documentationUrl": { "type": "string", "format": "uri" },
            "title": true,
            "severity": true,
            "confidence": true,
            "actual": true,
            "expected": true,
            "evidence": true,
            "affectedOperationIds": true,
            "sourceChangeIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/string" }
            },
            "sourcePaths": true
          }
        }
      ]
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale", "findings"],
      "properties": {
        "status": { "enum": ["passed", "failed", "not-assessed"] },
        "rationale": { "$ref": "#/$defs/string" },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/complianceFinding" }
        }
      }
    }
  }
}
