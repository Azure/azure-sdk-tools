  "dimensions": {
    "semanticUnderstanding": {
      "items": [
        {
          "id": "pr-43308-intent",
          "intent": "Replace OpenAPI-only long-running-operation extensions with Azure.Core @useFinalStateVia(\"location\"), preserving all six REST contracts while making three operations consistently recognizable as LROs to SDK generators.",
          "transformationChain": [
            "Replace raw x-ms-long-running-operation and final-state-via extensions on the shared action helpers with @Azure.Core.useFinalStateVia(\"location\").",
            "Remove operation-level polling suppressions and explicit polling links made unnecessary by the shared TypeSpec LRO metadata.",
            "Preserve POST routes, parameters, 202 responses, Location and Retry-After headers, and final-state-via location in emitted OpenAPI.",
            "Represent the existing Location-polled behavior directly in TypeSpec so all affected operations have explicit LRO semantics."
          ],
          "restRepresentation": {
            "summary": "All six POST operations retain their existing 202 responses, Location and Retry-After headers, and Location-based final-state behavior; the change represents that existing LRO contract directly in TypeSpec.",
