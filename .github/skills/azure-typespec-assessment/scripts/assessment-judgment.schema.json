{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TypeSpec Assessment Judgment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "semanticIntents",
    "restDecisions",
    "downstreamDecisions",
    "overallConfidence",
    "blockers"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "semanticIntents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewUnitId",
          "title",
          "summary",
          "sourceChangeIds",
          "operationIds"
        ],
        "properties": {
          "reviewUnitId": { "type": "string", "pattern": "^semantic-" },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "sourceChangeIds": { "type": "array", "items": { "type": "string" } },
          "operationIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "restDecisions": { "$ref": "#/$defs/decisions" },
    "downstreamDecisions": { "$ref": "#/$defs/decisions" },
    "overallConfidence": { "enum": ["high", "medium", "low"] },
    "blockers": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateId", "decision", "rationale"],
        "properties": {
          "candidateId": { "type": "string" },
          "decision": { "enum": ["approve", "reject"] },
          "severity": { "enum": ["high", "medium", "low"] },
          "rationale": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "decision": { "const": "approve" } } },
            "then": { "required": ["severity"] }
          }
        ]
      }
    }
  }
}
