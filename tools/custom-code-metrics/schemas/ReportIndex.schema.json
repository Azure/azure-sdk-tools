{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/Azure/azure-sdk-tools/main/tools/custom-code-metrics/schemas/ReportIndex.schema.json",
    "type": "object",
    "properties": {
        "schemaVersion": {
            "type": "string",
            "const": "1.0"
        },
        "latest": {
            "type": "string",
            "pattern": "^snapshots/[0-9]{8}T[0-9]{13}Z-[0-9a-f]{40,64}\\.json$",
            "description": "Latest complete snapshot, relative to this index."
        },
        "history": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/HistoryReference"
            },
            "minItems": 1,
            "description": "Monthly history is fetched on demand, not downloaded in full at startup."
        }
    },
    "required": [
        "schemaVersion",
        "latest",
        "history"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "description": "Revalidated discovery document; publish only after every referenced blob exists.",
    "$comment": "Generated from tools/custom-code-metrics/main.tsp in Azure/azure-sdk-tools. Run npm run generate in tools/custom-code-metrics; do not edit this file directly.",
    "$defs": {
        "HistoryReference": {
            "type": "object",
            "properties": {
                "month": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
                },
                "path": {
                    "type": "string",
                    "pattern": "^history/[0-9a-f]{64}/[0-9]{4}-(0[1-9]|1[0-2])\\.json$"
                }
            },
            "required": [
                "month",
                "path"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        }
    }
}